# Backend only. Copy to .env; never use VITE_ for server secrets.
# Values are literal single-line strings. No interpolation or inline comments.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5100

# Confirmed hosting projects; not used to create/deploy resources automatically.
GoogleCloud__CloudRunProjectId=melearn-tutor
GoogleCloud__DatabaseProjectId=melearn-infra-prod
# Confirmed Bangkok Cloud SQL instance (PostgreSQL 16).
GoogleCloud__Region=asia-southeast3
CloudSql__InstanceConnectionName=melearn-infra-prod:asia-southeast3:melearn-tutor-db
# Local Auth Proxy example (fill database/user/password after creating them):
# Host=127.0.0.1;Port=5433;Database=melearn;Username=melearn_app;Password=<secret>;Maximum Pool Size=5;Minimum Pool Size=0;Timeout=15
# Cloud Run uses Host=/cloudsql/<instance-connection-name> instead of loopback.
# Database adapter/session/business endpoints are not implemented yet.
ConnectionStrings__Melearn=
# Optional bootstrap admin password; keep blank in committed template.
# Never use the postgres administrator as application runtime credentials.
CloudSql__AdminPassword=

# Firebase Admin: project ID plus credentials managed outside the repository.
# Leave credentials blank when using Application Default Credentials.
# Authentication integration is not implemented yet.
Firebase__ProjectId=
GOOGLE_APPLICATION_CREDENTIALS=

# OpenRouter: copy the exact model ID from OpenRouter; no default paid model.
OpenRouter__ApiKey=
OpenRouter__Model=
OpenRouter__BaseUrl=https://openrouter.ai/api/v1

# Resend: From must use a sender/domain authorized in your Resend account.
# ReplyTo is optional. Email integration is not implemented yet.
Resend__ApiKey=
Resend__From=
Resend__ReplyTo=
Resend__BaseUrl=https://api.resend.com

# PostgreSQL and R2 selected; session transport and upload protocol undecided.
# R2 settings are prepared above; provider/upload integration is still pending.

# Cloudflare R2 (Backend only); upload adapter is not implemented yet.
# AccountId: Cloudflare account ID. BucketName: existing R2 bucket name.
# ServiceUrl: paste the bucket S3 API endpoint from Cloudflare.
# PublicBaseUrl: optional public/custom domain URL; leave blank for private buckets.
# AccessKeyId / SecretAccessKey: R2 S3 API credentials, never Firebase/API tokens.
CloudflareR2__AccountId=
CloudflareR2__BucketName=
CloudflareR2__ServiceUrl=
CloudflareR2__PublicBaseUrl=
CloudflareR2__AccessKeyId=
CloudflareR2__SecretAccessKey=
