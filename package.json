{
  "name": "elearning-ux-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @melearn/web",
    "dev:admin": "npm run dev --workspace @melearn/admin",
    "build": "npm run tokens:check && npm run build --workspace @melearn/web && npm run build --workspace @melearn/admin",
    "build:web": "npm run tokens:check && npm run build --workspace @melearn/web",
    "build:admin": "npm run tokens:check && npm run build --workspace @melearn/admin",
    "preview:web": "npm run preview --workspace @melearn/web",
    "preview:admin": "npm run preview --workspace @melearn/admin",
    "typecheck": "npm run typecheck:web && npm run typecheck:admin && npm run typecheck:packages",
    "typecheck:web": "npm run typecheck --workspace @melearn/web",
    "typecheck:admin": "npm run typecheck --workspace @melearn/admin",
    "typecheck:packages": "tsc --noEmit",
    "tokens:generate": "node scripts/generate-ui-tokens.mjs",
    "tokens:check": "node scripts/generate-ui-tokens.mjs --check",
    "test": "node --test",
    "check:boundaries": "node scripts/check-app-boundaries.mjs",
    "contracts:setup": "npm ci --prefix tools/contract-codegen --ignore-scripts",
    "contracts:validate": "node scripts/contracts.mjs",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:examples": "node scripts/contract-examples.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/anuphan": "^5.3.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "antd": "^6.6.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
