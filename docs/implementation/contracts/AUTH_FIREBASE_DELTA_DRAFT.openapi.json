  "paths": {
    "/auth/firebase/exchange": {
      "post": {
        "operationId": "post_auth_firebase_exchange",
        "tags": [
          "auth"
        ],
        "summary": "Exchange verified Firebase identity for an app session",
        "x-status": "PROPOSED_HTTP_DELTA",
        "x-source-decision": "D03",
        "x-permission": "server_verified_identity; Admin app requires local Admin grant",
        "security": [],
        "parameters": [
          {
            "name": "x-melearn-app",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "admin"
              ]
            },
            "description": "Exchange audience must match this header; link uses the bound session namespace."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FirebaseExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected app session cookie and canonical user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Proposed error code credentials_invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "credentials_invalid"
          },
          "403": {
            "description": "Proposed error code forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "forbidden"
          },
          "409": {
            "description": "Proposed error code firebase_identity_conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "firebase_identity_conflict"
          },
          "422": {
            "description": "Proposed error code validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "validation_failed"
          },
          "503": {
            "description": "Proposed error code auth_provider_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "auth_provider_unavailable"
          }
        }
      }
    },
    "/auth/firebase/link": {
      "post": {
        "operationId": "post_auth_firebase_link",
        "tags": [
          "auth"
        ],
        "summary": "Explicitly bind a verified Firebase identity to the current account",
        "x-status": "PROPOSED_HTTP_DELTA",
        "x-source-decision": "D03",
        "x-permission": "self_account; no identity transfer or email auto-merge",
        "security": [
          {
            "WebSession": []
          },
          {
            "AdminSession": []
          }
        ],
        "parameters": [
          {
            "name": "x-melearn-app",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "admin"
              ]
            },
            "description": "Exchange audience must match this header; link uses the bound session namespace."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FirebaseLinkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original account, no session rotation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "Proposed error code credentials_invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
