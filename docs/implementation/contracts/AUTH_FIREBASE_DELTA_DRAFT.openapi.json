                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email_verified": {
            "type": "boolean"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "learner",
                "instructor",
                "admin"
              ]
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "self_email",
              "google",
              "admin_created"
            ]
          },
          "auth_methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "password",
                "google"
              ]
            }
          },
          "learning_eligible": {
            "type": "boolean"
          },
          "profile": {
            "$ref": "#/components/schemas/AccountProfile"
          }
        },
        "required": [
          "id",
          "display_name",
          "username",
          "email",
          "email_verified",
          "avatar_url",
          "roles",
          "origin",
          "auth_methods",
          "learning_eligible",
          "profile"
        ],
        "additionalProperties": false
      },
      "AccountProfile": {
        "type": "object",
        "properties": {
          "bio": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "firstNameEnglish": {
            "type": "string"
          },
          "lastNameEnglish": {
            "type": "string"
          },
          "certificateName": {
            "type": "string"
          },
          "birthDate": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "educationLevel": {
            "type": "string"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          },
          "learningGoals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
