            "x-proposed-error-code": "credentials_invalid"
          },
          "403": {
            "description": "Proposed error code forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "forbidden"
          },
          "409": {
            "description": "Proposed error code firebase_identity_conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "firebase_identity_conflict"
          },
          "422": {
            "description": "Proposed error code validation_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "x-proposed-error-code": "validation_failed"
          },
          "503": {
