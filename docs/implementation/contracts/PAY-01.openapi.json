            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "ResourceValidationField": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "additionalProperties": false
