FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/course-authoring/package.json packages/course-authoring/package.json
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY public public
COPY scripts scripts
COPY packages packages
COPY apps apps
ARG APP_NAME
ENV VITE_API_MODE=mock VITE_API_BASE_URL=/mock-api/v1 VITE_APP_ENV=preview
RUN npm run build:${APP_NAME} && cp -r dist/${APP_NAME} /static

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
ARG APP_NAME
ENV APP_NAME=${APP_NAME} MELEARN_MOCK_PREVIEW=true PORT=8080
COPY --from=build /static static
COPY tools/provisional-api tools/provisional-api
COPY tools/mock-preview tools/mock-preview
USER node
EXPOSE 8080
CMD ["node", "tools/mock-preview/server.mjs"]
