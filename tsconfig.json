{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": false,

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@melearn/course-authoring": ["./packages/course-authoring/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "tests/**/*.ts"]
}
