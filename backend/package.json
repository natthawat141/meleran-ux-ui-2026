{
  "name": "melearn-nest-api",
  "version": "1.0.0",
  "description": "Melearn Modular API in NestJS",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "test:foundation": "node node_modules/jest/bin/jest.js --config test/jest-foundation.json --runInBand",
    "test:components": "node node_modules/jest/bin/jest.js --config test/jest-components.json --runInBand",
    "test:frontend-detail": "node scripts/verify-frontend-detail.cjs",
    "test:database": "node node_modules/jest/bin/jest.js --config test/jest-database.json --runInBand",
    "db:test:validate": "node scripts/prisma-test.cjs validate",
    "db:test:generate": "node scripts/prisma-test.cjs generate",
    "db:test:migrate": "node scripts/prisma-test.cjs migrate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "check:blueprint": "node scripts/check-blueprint.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.19.0"
}
